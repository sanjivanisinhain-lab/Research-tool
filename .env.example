# Copy to .env and fill in. NEVER commit .env (it is git-ignored). Values below are examples.

# --- AI ---------------------------------------------------------------------
GEMINI_API_KEY=                    # from aistudio.google.com. Free-tier keys may let Google use what is sent; see docs/SECURITY.md
# GEMINI_MODEL=gemini-3.5-flash-lite          # text and extraction
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash    # recordings and screen analysis
# GEMINI_KEY_IN_URL=1              # only if a proxy on your network strips the key header

# --- Who can sign in ------------------------------------------------------------
ALLOWED_EMAIL_DOMAINS=snapdeal.com # comma-separated. Leave EMPTY only if anyone on the internet may create an account.
ADMIN_SETUP_CODE=                  # set a long random value: the very first sign-up (the admin) must enter it
COOKIE_SECURE=1                    # 1 when served over https (recommended). Use 0 only for plain http inside a trusted network.
TRUST_PROXY=1                      # 1 when behind Caddy/nginx/a load balancer

# --- Limits (per person, per hour) --------------------------------------------
# RATE_AI_PER_HOUR=60              # questions, assessments, persona messages
# RATE_NOTES_PER_HOUR=20           # contributed notes and study requests

# --- Backups ------------------------------------------------------------------
# FIGMA_TOKEN=                     # optional: lets Assess open Figma links. A read-only personal access token (Figma settings, Security). Never commit it
# GOOGLE_SERVICE_ACCOUNT_FILE=      # optional: path to a Google service account key (JSON) so linked Google Sheets stay in step. See docs/SHEETS.md. Never commit the key
# SHEET_SYNC_MINUTES=10            # how often linked sheets are checked
BACKUP_PASSPHRASE=                 # set a strong value: backups contain password hashes and the list of removed names
# BACKUP_KEEP=14                   # how many to keep in /data/backups

# --- Https (docker compose --profile https) ----------------------------------
DOMAIN=research.example.com
